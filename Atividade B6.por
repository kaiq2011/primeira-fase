programa {
  funcao inicio() {
   //infos e variaveis
   real valor_atual
   real valor_a_ser_vendido
   //entrada de dados
   escreva ("por quanto você comprou a arte? ")
   leia (valor_atual)
   ///processamento
   valor_a_ser_vendido=valor_atual*3
   //saida de dados 
   escreva ("o valor que você devera vender para ganhar essa porcentagem seria: R$" + valor_a_ser_vendido)
  }
}
