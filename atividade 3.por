programa {
  funcao inicio() {
    //entendimento do problema
    //infos e variaveis
    inteiro estagiarios
    inteiro devsClt
    inteiro devsPj
    inteiro total
    inteiro resultado 
    //entrada de dados
    escreva ("quantos estagiarios você tem? ")
    leia(estagiarios)
    escreva ("quantos devsClt você tem? ")
    leia(devsClt)
    escreva ("quantos devsPj você tem? ")
    leia(devsPj)
    //processamento
    total = estagiarios + devsClt + devsPj
    resultado = total
    //saida 
    escreva("o resultado da quantia de quantos devs há na empresa é de: ")
    escreva (resultado)

  }
}
