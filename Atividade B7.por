programa {
  funcao inicio() {
    //infos e variaveis
    real peso_do_produto
    real preco
    //entrada de dados
    escreva ("Digite qual o peso do produto (em gramas): ")
    leia (peso_do_produto)
    //processamento
    preco=peso_do_produto/100
    //saida de dados
    escreva ("o valor é: R$ " +preco )

  }
}
