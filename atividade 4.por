programa {
  funcao inicio() {
    //entedimento de problema
    //infos e variaveis
    inteiro laranjaInicio
    inteiro laranjaFinal
    inteiro calculo
    inteiro quantidade
    //entrada de dados
    escreva ("quantas laranjas você tinha? ")
    leia(laranjaInicio)
    escreva("quantas laranjas você tem agora? ")
    leia(laranjaFinal)
    //processamento
    calculo = laranjaInicio - laranjaFinal 
    quantidade = calculo 
    //saida
    escreva ("a quantidade de laranjas que você vendeu foi de aproximadamente: ")
    escreva (quantidade)
  }
}
