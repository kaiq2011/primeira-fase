programa {
  funcao inicio() {
   inteiro numero_1
   inteiro numero_2
   escreva ("Escolha Um Número: ")
   leia (numero_1)
   escreva ("Escolha Outro Número: ")
   leia (numero_2)
    se (numero_1 < numero_2){
      escreva ("O " + numero_1 + " É Menor que o " + numero_2)
    }
    se (numero_1 > numero_2){
      escreva ("O "+numero_2+" É Menor que o "+numero_1)
    } se (numero_1 == numero_2){

    escreva ("Seus números são iguais")
    }

  }
}
