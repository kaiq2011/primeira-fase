programa {
  funcao inicio() {
    inteiro numero
    escreva ("Escolha um número e eu te darei o número em dia da semana (1 a 7): ")
    leia(numero)
    se(numero == 1){
      escreva ("1 = Domingo")
    } se (numero == 2){
      escreva("2 = Segunda-Feira")
    } se (numero == 3){
      escreva ("3 = Terça-Feira")
    } se (numero == 4){
      escreva ("4 = Quarta-Feira")
    } se (numero == 5){
      escreva ("5 = Quinta-Feira")
    } se (numero == 6){
      escreva ("6 = Sexta-Feira")
    } se (numero == 7){
      escreva ("7 = Sábado")
    }

  }
}
